{
  "name": "@halecraft/mcp-cloudron",
  "version": "0.7.0",
  "description": "MCP server for Cloudron 9/10 instance management with read/write/destructive access levels",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-cloudron": "dist/server.js",
    "mcp-cloudron-http": "dist/app.js"
  },
  "files": [
    "dist",
    "resources",
    "ui",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch src/index.ts",
    "verify": "verify",
    "test:integration": "vitest run --project integration",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "start:http": "node dist/app.js"
  },
  "keywords": [
    "mcp",
    "cloudron",
    "model-context-protocol",
    "ai",
    "automation",
    "self-hosted",
    "server-management",
    "claude",
    "anthropic"
  ],
  "authors": [
    "Serenichron <vlad@serenichron.com>",
    "Duane Johnson <duane.johnson@gmail.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattstyles333/mcp-cloudron.git"
  },
  "bugs": {
    "url": "https://github.com/mattstyles333/mcp-cloudron/issues"
  },
  "homepage": "https://github.com/mattstyles333/mcp-cloudron#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@halecraft/verify": "^1.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "@types/node": "^24.10.2",
    "dotenv": "^17.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3"
  },
  "pnpm": {
    "overrides": {
      "test-exclude": "^7.0.1"
    }
  }
}
