# Cloudron MCP Server Environment Configuration
# Copy this file to .env (gitignored) for local testing

# Dashboard URL of your Cloudron (https required, except localhost)
CLOUDRON_BASE_URL=https://my.example.com

# API token from the dashboard: Settings → API Tokens.
# Prefer a read-only token; it can only make GET requests.
CLOUDRON_API_TOKEN=your-api-token-here

# Which tools the server offers: read (default), write, or all
# CLOUDRON_ACCESS=read
